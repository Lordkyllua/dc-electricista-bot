# Token de acceso de WhatsApp (lo obtenés en Meta for Developers)
WHATSAPP_TOKEN=tu_token_de_meta_aqui

# Token que vos inventás para verificar el webhook (cualquier texto secreto)
VERIFY_TOKEN=dc_electricista_secret_2025

# API Key de Anthropic (la obtenés en console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui

# Puerto (Railway lo asigna automáticamente, no tocar)
PORT=3000
